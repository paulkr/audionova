# Copy to .env.local and fill in what you need. .env.local is gitignored.
# Real environment variables take precedence over this file.

# Enables the model planner and chat refinement. Without it the studio still
# works with the rule-based planner, and every test suite runs offline.
ANTHROPIC_API_KEY=

# Optional overrides for the two planner stages. Unset means the defaults in
# backend/plan/pipeline.py. The canary (python -m backend.plan.canary) reads
# the same values, so it always tests what the product runs.
# ANTHROPIC_PLAN_MODEL=
# ANTHROPIC_EMIT_MODEL=

# Optional: reads the chain's explanation aloud in the studio. The button only
# appears when a key is set.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# Read by the browser; only needed if the API is not on localhost:8787.
# NEXT_PUBLIC_API_BASE=http://localhost:8787
